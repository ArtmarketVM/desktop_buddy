{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Buddy",
  "version": "0.48.1",
  "identifier": "com.artmarketvm.desktopbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "sumi",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        },
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600
      },
      {
        "label": "buddy",
        "create": false,
        "title": "sumi",
        "url": "index.html?buddy=panel",
        "width": 328,
        "height": 240,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "mascot",
        "create": false,
        "title": "sumi",
        "url": "index.html?buddy=mascot",
        "width": 160,
        "height": 152,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "desktopbuddy"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNTZGNjA2N0JBNzhBRTUKUldUbGlxZDdCdlpXM0dxclVCZmpnZEFHYTZSNHVIdXcwWE0rT1JKS1BQV0VyUjU4Tmt4cW9WRGMK",
      "endpoints": [
        "https://github.com/ArtmarketVM/desktop_buddy/releases/latest/download/updates-epoch-3.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A quiet focus companion",
    "category": "Productivity",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
