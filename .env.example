# Runtime only. Copy to .env for local development. Never commit credentials.
# Full chat completions endpoint, not a base URL.
NEBIUS_API_URL=https://api.tokenfactory.nebius.com/v1/chat/completions
NEBIUS_API_KEY=
# Verify model availability in your Nebius account.
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=
# Simulated activity; AI calls are still real unless AI_MOCK is explicitly true.
DEMO_MODE=false
AI_MOCK=false
# Optional public HTTPS contact-service endpoint. No server secrets belong in this file.
CONTACT_API_URL=
