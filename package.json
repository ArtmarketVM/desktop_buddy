{
  "name": "desktop-buddy",
  "private": true,
  "version": "0.49.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-version.mjs && tsc -b && vite build",
    "test": "vitest run",
    "lint": "node scripts/lint-frontend.mjs",
    "lint:rust": "node scripts/lint-rust.mjs",
    "lint:unused": "node scripts/lint-unused.mjs",
    "test:visual": "playwright test --update-snapshots=none",
    "test:visual:list": "playwright test --list",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:candidates": "node scripts/visual-candidates.mjs",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "test:acceptance": "node scripts/run-acceptance.mjs",
    "test:acceptance:plan": "node scripts/run-acceptance.mjs --plan",
    "test:acceptance:runner": "node --test scripts/acceptance.verify.mjs",
    "test:release": "node --test scripts/update-manifest.verify.mjs scripts/signing-trust.verify.mjs scripts/macos-update.verify.mjs scripts/retained-windows.verify.mjs scripts/release.verify.mjs scripts/macos-code-signing.verify.mjs scripts/credential-helper.verify.mjs",
    "test:contact": "node --test server/contact.verify.mjs",
    "test:gateway": "node --test server/supabase/functions/buddy-ai/handler.verify.mjs",
    "tauri": "tauri",
    "dev:macos": "tauri dev",
    "build:macos": "bash scripts/build-macos.sh",
    "test:ci": "node --test scripts/ci.verify.mjs",
    "ci:watch": "node scripts/watch-ci.mjs",
    "ci:plan": "node scripts/ci-inputs.mjs --plan",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "knip": "6.42.1",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.72.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
